font-family:jua;
margin-top:100px;
margin-left:20px;
"
>
개인정보를 수정할 수 있습니다.
</p>


<script type="module">

import {
  createClient
} from "https://esm.sh/@supabase/supabase-js@2";


const supabase = createClient(

  "https://scttowfhygcpdirrekqm.supabase.co",

  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNjdHRvd2ZoeWdjcGRpcnJla3FtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAxOTg0MjYsImV4cCI6MjA5NTc3NDQyNn0.XwdQhJ4Ku_C61yXz0k65AztMF9Rfe7Qzn3Av7iWRBqY"

);


// =============================
// 개인정보 수정
// =============================

window.개인정보수정 = async function () {


  const 새이름 =
    document.getElementById("새이름").value.trim();


  const 새아이디 =
    document.getElementById("새아이디").value.trim();


  const 새비밀번호 =
    document.getElementById("새비밀번호").value;


  // =========================
  // 현재 로그인 사용자 확인
  // =========================

  const {
    data: { user },
    error: userError
  } = await supabase.auth.getUser();


  if (userError || !user) {

    alert("로그인이 필요합니다.");

    location.href = "login.html";

    return;
  }


  // =========================
  // 이름 변경
  // =========================

  if (새이름 !== "") {


    // users.name 변경

    const { error: nameError } =
      await supabase
        .from("users")
        .update({
          name: 새이름
        })
        .eq("user_id", user.id);


    if (nameError) {

      console.error(nameError);

      alert(
        "users의 이름 변경 실패:\n" +
        nameError.message
      );

      return;
    }


    // Supabase Auth Display Name 변경

    const {
      error: authNameError
    } =
      await supabase.auth.updateUser({

        data: {
          display_name: 새이름
        }

      });


    if (authNameError) {

      console.error(authNameError);

      alert(
        "Auth의 Display Name 변경 실패:\n" +
        authNameError.message
      );

      return;
    }

  }


  // =========================
  // 아이디 변경
  // =========================

  if (새아이디 !== "") {


    const {
      error: loginIdError
    } =
      await supabase
        .from("users")
        .update({
          login_id: 새아이디
        })
        .eq("user_id", user.id);


    if (loginIdError) {

      console.error(loginIdError);

      alert(
        "아이디 변경 실패:\n" +
        loginIdError.message
      );

      return;
    }

  }


  // =========================
  // 비밀번호 변경
  // =========================

  if (새비밀번호 !== "") {


    if (새비밀번호.length < 6) {

      alert(
        "비밀번호는 최소 6자 이상이어야 합니다."
      );

      return;
    }


    const {
      error: passwordError
    } =
      await supabase.auth.updateUser({

        password: 새비밀번호

      });


    if (passwordError) {

      console.error(passwordError);

      alert(
        "비밀번호 변경 실패:\n" +
        passwordError.message
      );

      return;
    }

  }


  // =========================
  // 입력칸 초기화
  // =========================

  document.getElementById("새이름").value = "";
  document.getElementById("새아이디").value = "";
  document.getElementById("새비밀번호").value = "";


  alert("개인정보가 수정되었습니다.");


  // 설정 페이지로 돌아가기

  location.href = "settings.html";

};

</script>


