; DORONUM FACTORY — INFINITE INDUSTRY
; Native Godot 4 3D game. No Unity and no browser runtime.
config_version=5

[application]
config/name="DORONUM FACTORY — INFINITE INDUSTRY"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="A native 3D exploration, crafting, research and industrial automation game."

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[physics]
3d/default_gravity=24.0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.015, 0.035, 0.075, 1)
